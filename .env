# --- App ---
APP_ENV=development
HTTP_PORT=8080

# --- Auth ---
# REQUIRED: use a long random secret in production.
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- Database (compose builds DATABASE_URL from these) ---
POSTGRES_USER=casemind
POSTGRES_PASSWORD=casemind
POSTGRES_DB=casemind
# For running the API outside docker:
# DATABASE_URL=postgres://casemind:casemind@localhost:5432/casemind?sslmode=disable
AUTO_MIGRATE=true

# --- Redis ---
# REDIS_ADDR=localhost:6379

# --- LLM ---
# "mock" runs the full game loop without an external model.
# To use GLM/OpenAI-compatible APIs, set LLM_PROVIDER=glm and fill the
# base URL/API key below.
LLM_PROVIDER=glm
LLM_BASE_URL=http://192.168.1.203:8010/v1
LLM_API_KEY=sk-octopus-qYYfYfvogJeQuVE9SAFXYCob2DEHixlPfLjlScohUMZS8MyX
LLM_MODEL=glm-5.2
LLM_TIMEOUT_SECONDS=6000
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# --- Optional MinIO/Qdrant extras ---
# Default docker compose does not start these. Use:
# docker compose --profile extras up --build
# MINIO_ENDPOINT=minio:9000
# QDRANT_URL=http://qdrant:6333
MINIO_ROOT_USER=casemind
MINIO_ROOT_PASSWORD=casemind-secret
MINIO_BUCKET=casemind

# --- Rate limiting ---
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_AGENT_PER_MINUTE=30
