AUTO_MIGRATE=true

# --- Redis ---
# REDIS_ADDR=localhost:6379

# --- LLM ---
# "mock" runs the full game loop without an external model.
# To use GLM/OpenAI-compatible APIs, set LLM_PROVIDER=glm and fill the
# base URL/API key below.
LLM_PROVIDER=qwen
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=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
LLM_MODEL=qwen/qwen3-coder:free
LLM_TIMEOUT_SECONDS=6000
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# --- Optional MinIO/Qdrant extras ---
# Default docker compose does not start these. Use:
# docker compose --profile extras up --build
# MINIO_ENDPOINT=minio:9000
# QDRANT_URL=http://qdrant:6333
MINIO_ROOT_USER=casemind
MINIO_ROOT_PASSWORD=c1TecxzYsZrX+d+WIl2bBKOVT8/s5vV1w1gCnG2GAKX4=
MINIO_BUCKET=casemind

# --- Rate limiting ---
RATE_LIMIT_AUTH_PER_MINUTE=20
