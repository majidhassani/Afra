# AgentVerse web client configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_ENABLE_MOCKS=false
VITE_DEFAULT_LANGUAGE=fa
VITE_APP_VERSION=dev
# Real Google Maps for the mission map; when empty the tactical fallback board renders.
VITE_GOOGLE_MAPS_API_KEY=
# Diagnostics screen in production builds (always available in dev).
VITE_ENABLE_DIAGNOSTICS=false
